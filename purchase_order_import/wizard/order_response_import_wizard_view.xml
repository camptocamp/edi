<odoo>
    <record id="order_response_import_wizard_form" model="ir.ui.view">
        <field name="name">order.response.import.wizard.form</field>
        <field name="model">order.response.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import OrderResponse File from Supplier">
                <group name="help-import">
                    <div>
                        <p
                        >Upload below the OrderResponse you received from your supplier. When you click on the import button:</p>
                        <ol>
                            <li
                            >If it is an XML file, Odoo will parse it if the module that adds support for this XML format is installed. For the <a
                                href="http://ubl.xml.org/"
                                target="_blank"
                            >Universal Business Language</a> format (UBL), you should install the module <em
                            >order_response_import_ubl</em>.</li>
                            <li
                            >If it is a PDF file, Odoo will try to find an XML file in the attachments of the PDF file and then use this XML file.</li>
                        </ol>
                        <p
                        >Then, Odoo will process the related purchase order as follows:</p>
                        <ul>
                            <li
                            >If the status code is acknowledgement: update the acknowledge datetime on the PO</li>
                            <li>If the status code is Rejected: cancel the PO</li>
                            <li
                            >If the status code is Accepted: confirm the PO and create the picking</li>
                            <li
                            >If the status code is Conditionally accepted: confirm the PO, create the picking, and update the receipt moves according to the amendments specified in the document</li>
                        </ul>
                        <p>Possible line amendments:</p>
                        <ul>
                            <li
                            >The order line is refused: The receipt move is cancelled</li>
                            <li
                            >The order line is accepted with change: The receipt move is split. If a backorder quantity is provided, a backorder is created. Otherwise the move for the remaining quantity is cancelled.</li>
                        </ul>
                    </div>
                </group>
                <group name="main">
                    <field name="document" widget="binary" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="process_document"
                        type="object"
                        class="oe_highlight"
                        string="Import document"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>

    <record id="order_response_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Quotation</field>
        <field name="res_model">order.response.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="order_response_import_wizard_importer_menu"
        parent="purchase.menu_procurement_management"
        name="UBL OrderResponse Importer"
        action="order_response_import_wizard_action"
        groups="purchase.group_purchase_user"
        sequence="99"
    />
</odoo>
